# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Whisper (Speech-to-Text)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en

# Ollama (Local LLM)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:latest
OLLAMA_TEMPERATURE=0.3
OLLAMA_TOP_P=0.9
OLLAMA_TOP_K=40
OLLAMA_NUM_PREDICT=1024
OLLAMA_TIMEOUT=120

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=False
API_WORKERS=4

# File Upload
MAX_UPLOAD_SIZE=104857600

# Logging
LOG_LEVEL=INFO
DEBUG=False

# Processing
TRANSCRIPT_CHUNK_SIZE=2000
TRANSCRIPT_CHUNK_OVERLAP=200

# Job Configuration
JOB_TIMEOUT=1800
REQUEST_TIMEOUT=300
MAX_RETRIES=3
RETRY_DELAY=60

# Testing
TEST_MODE=False
PRINT_CONFIG_ON_STARTUP=True
